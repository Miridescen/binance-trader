[Unit]
Description=24h 周期实盘策略（子账号，跌幅榜-空 无过滤，batch 隔离，组内 +10U 提前平 / 否则跑满 24h）
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/binance-trader
# ★ 子账号密钥：BINANCE_API_KEY / BINANCE_API_SECRET 放这个文件（chmod 600）。
#   binance_client 的 load_dotenv(override=False) 不覆盖已存在的环境变量，
#   故本进程走子账号，其余服务照旧走 .env 主账号。
EnvironmentFile=/root/binance-trader/.env.sub24h
# ★ 实盘开关：先保持注释＝观察模式（只选币/打印/算浮盈，不下单不写库）。
#   在服务器上核对无误、且确认读到的是子账号余额后，取消下一行注释再
#   systemctl daemon-reload && systemctl restart binance-real-24h
# Environment=REAL_24H_LIVE=1
ExecStart=/usr/bin/python3 /root/binance-trader/real_trade_24h.py
Restart=always
RestartSec=30
StartLimitIntervalSec=0

StandardOutput=append:/root/binance-trader/logs/binance-real-24h.log
StandardError=append:/root/binance-trader/logs/binance-real-24h.log

[Install]
WantedBy=multi-user.target
